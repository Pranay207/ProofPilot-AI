# PostgreSQL database URL for production-style mode.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proofpilot_ai?schema=public"

# API server port.
API_PORT=4000

# Keep false for local sample-data API mode. Set true after running Prisma migrations.
USE_DATABASE=false

# Razorpay test-mode integration. Keep real values only in .env, never in git.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_random_webhook_secret
