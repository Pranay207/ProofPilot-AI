# PostgreSQL database URL for production-style mode.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proofpilot_ai?schema=public"

# API server port.
API_PORT=4000

# Production must use PostgreSQL. Local development may keep this false.
USE_DATABASE=false

# Razorpay test-mode integration. Keep real values only in .env, never in git.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_random_webhook_secret

# Production webhook routing identity. This must match the authenticated merchant subject.
RAZORPAY_MERCHANT_AUTH_SUBJECT=replace_with_oidc_subject
RAZORPAY_MERCHANT_NAME=Your Merchant
RAZORPAY_MERCHANT_EMAIL=ops@example.com

# OIDC/JWT verification. The API rejects requests without a valid bearer token in production.
AUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
AUTH_ISSUER=https://your-idp.example.com/
AUTH_AUDIENCE=proofpilot-api

# S3-compatible evidence storage. AWS credentials are supplied by the runtime role/environment.
EVIDENCE_STORAGE_PROVIDER=s3
EVIDENCE_S3_BUCKET=proofpilot-evidence-production
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=
AWS_S3_FORCE_PATH_STYLE=false
